---
import ResponsiveImage from './ResponsiveImage.astro';
import type { SpeakerEntry } from '../lib/content';
interface Props {
  speaker: SpeakerEntry;
  wide?: boolean;
}
const { speaker, wide = false } = Astro.props;
const avatar = speaker.data.acf?.speaker_avatar?.url || '/theme/assets/img/person.png';
const cats = (speaker.data.terms?.talks_cat || []).map((cat) => cat.id).join(',');
---
<a
  href={speaker.data.path}
  class:list={[wide ? 'col-6 col-sm-3' : 'col-6 col-sm-3 col-md-2', 'speaker-profile-wrapper']}
  title="See the speaker's profile"
  data-filter-card
  data-name={speaker.data.title}
  data-position={speaker.data.acf?.speaker_position || ''}
  data-cats={cats}
>
  <div class="speaker-profile">
    <div class="speaker-avatar-wrap">
      <div class="speaker-avatar">
        <ResponsiveImage src={avatar} alt={speaker.data.title} wrap classes="speaker-av" />
      </div>
    </div>
    <div class="profile-info">
      <div class="speaker-name"><span class="load">{speaker.data.title}</span></div>
      {speaker.data.acf?.speaker_position && (
        <div class="speaker-position"><span class="load">{speaker.data.acf.speaker_position}</span></div>
      )}
    </div>
  </div>
</a>

---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import { loadLibrary } from '../lib/content';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Home page is missing from the content export');
const library = await loadLibrary();
const description = page.data.seo?.description || '';
---
<Base
  title={page.data.seo?.title || page.data.title}
  description={description}
  image={page.data.seo?.ogImage || page.data.featuredImage || undefined}
  path="/"
  bodyClass="home page-template-page-dark-theme"
>
  <Blocks blocks={page.data.blocks} entry={page} library={library} />
</Base>

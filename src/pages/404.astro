---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page is not on Sphere.it." path="/404/">
  <div class="container-fluid px-0 page-default">
    <div class="container-flexible">
      <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
          <h1 class="heading-single">Page not found</h1>
          <p>The page you requested is not part of this archive. Try the <a href="/">home page</a>, <a href="/events/">events</a>, or <a href="/watch/">talks</a>.</p>
        </div>
      </div>
    </div>
  </div>
</Base>

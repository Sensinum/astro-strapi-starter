      "name": "acf/block-text-columns",
      "anchor": "acf-block-65c09eb1eec9d",
      "data": {
        "block_title": "The SpHERe.it Conference is for",
        "block_description": "The SpHERe.it Conference brings together a vibrant mix of individuals and encourage professionals of any gender who find themselves in a position to contribute, share, and benefit from the community.",
        "block_columns": [
          {
            "title": "Women in Tech and Career Changers",
            "description": "Women across various backgrounds, celebrating their journey in technology. Returning Professionals overcoming challenges of career breaks.",
            "bg_color": "rgba(86,86,232,0.85)"
          },
          {
            "title": "Industry Leaders and Professionals",
            "description": "Experts & Tech Leaders shaping the future of the industry. Beyond Senior Professionals seeking proactive approaches to career advancement. Entrepreneurs driving innovation and impact in the tech landscape.",
            "bg_color": "rgb(255,153,94)"
          },
          {
            "title": "Tech Enthusiasts",
            "description": "Individuals of any gender passionate about contributing to and benefiting from the tech community. Tech Enthusiasts eager to explore the latest trends and innovations.",
            "bg_color": "rgb(151,216,196)"
          }
        ],

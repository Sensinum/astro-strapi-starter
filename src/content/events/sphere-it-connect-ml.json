    {
      "kind": "acf",
      "name": "acf/block-half-bg-image",
      "anchor": "acf-block-66e2938657762",
      "data": {
        "block_description": "<div class=\"font-montserrat content\">\r\n\r\nSeats for the <strong>\"My PoC project is a success, what now?\"</strong> workshop are limited, so be sure to register quickly to secure your spot. This hands-on session with leading ML experts will take place at <strong>VirtusLab's Office, ul. Szlak 49</strong>.\r\n\r\nDon't miss this chance to take your machine learning knowledge to the next level!\r\n\r\n</div>",
        "block_button": {
          "title": "Sign up for the workshop",
          "url": "https://app.evenea.pl/event/sphere-connect-ml-engineering/",
          "target": "_blank"
        },
        "cta_background_color": "#f5e8dc",

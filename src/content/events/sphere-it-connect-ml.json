      "kind": "acf",
      "name": "acf/block-full-bg-image",
      "anchor": "acf-block-63ce920e00205",
      "data": {
        "block_title": null,
        "block_description": "<div class=\"font-montserrat content\">\r\n\r\nJoin us for a day of insights and networking, as we gather top minds in <strong>machine learning</strong> <strong>engineering</strong>. Explore the latest trends, learn about cutting-edge technologies, and connect with like-minded professionals passionate about <strong>AI</strong> and <strong>ML</strong>. Whether you're an expert or just starting out, this event will inspire and engage you.\r\n\r\nEnd the night with a fun <strong>Halloween afterparty</strong> - a perfect way to unwind and celebrate with the community!\r\n\r\n</div>",
        "block_button": {
          "title": "Save your seat",
          "url": "https://app.evenea.pl/event/sphere-connect-ml-engineering/",
          "target": "_blank"
        },
        "cta_background_color": null,

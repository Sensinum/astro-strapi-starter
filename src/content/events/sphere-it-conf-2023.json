    {
      "kind": "acf",
      "name": "acf/block-half-bg-image",
      "anchor": "acf-block-649daf66a36d1",
      "data": {
        "block_description": "<h2 class=\"heading-3\">Attend Sphere.it Conf</h2>\r\nSecure your spot today and embark on a transformative experience that will empower you, ignite your passion, and take you beyond the limits of traditional seniority. Unlock the secrets to professional success in IT at the Sphere.it Conf 2023.\r\n\r\nLimited seats are available. We recommend registering for the conference as soon as possible to secure the best possible pricing, as ticket prices will increase over time.",
        "block_button": {
          "title": "Get your tickets",
          "url": "https://evenea.pl/pl/wydarzenie/sphereitconf2023",
          "target": "_blank"
        },
        "cta_background_color": "#040c33",
        "cta_font_color": "#f8fcee",
        "cta_border_radius": 6,
        "block_background_image": {
          "id": 4453,
          "url": "/uploads/2023/03/sphere_conf_2023_tickets_bg.jpeg",
          "alt": "sphere_conf_2023_tickets_bg",
          "width": 1440,
          "height": 960
        },
        "switch_text_side": true,
        "block_background_color": "#6de3d7",
        "block_font_color": "#040c33",
        "menu_label": "Tickets"
      }
    },
    {
      "kind": "acf",
      "name": "acf/block-half-bg-image",
      "anchor": "acf-block-6409a2a30d4cf",
      "data": {
        "block_description": "<h2 class=\"heading-3\">Elevate your conference experience</h2>\r\nUpgrade to VIP for exclusive perks! Get VIP tickets, a special swag pack with sought-after extras like a branded hoodie and Stojo 16oz cup. Enjoy early workshop registration on September 27th and an invitation to the prestigious Speakers' Dinner Party.\r\n\r\nBe at the center of the action and uncover more exclusive opportunities. Make sure to check them out and grab your VIP Pack today.\r\n\r\n*Limited VIP Packs are available",
        "block_button": {
          "title": "Get your VIP pack",
          "url": "https://evenea.pl/pl/wydarzenie/sphereitconf2023",
          "target": "_blank"
        },
        "cta_background_color": null,
        "cta_font_color": "#040c33",
        "cta_border_radius": 6,
        "block_background_image": {
          "id": 4454,
          "url": "/uploads/2023/03/sphere_conf_2023_vippacks_bg.jpeg",
          "alt": "sphere_conf_2023_vippacks_bg",
          "width": 1440,
          "height": 960
        },
        "switch_text_side": false,
        "block_background_color": "#4e3aae",
        "block_font_color": "#eefcef",
        "menu_label": null
      }

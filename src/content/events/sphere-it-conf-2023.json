    {
      "kind": "acf",
      "name": "acf/block-full-bg-image",
      "anchor": "about-conf",
      "data": {
        "block_title": null,
        "block_description": "<p class=\"font-montserrat mb-0\" style=\"font-size: 120%; line-height: 170%; font-weight: 400; text-align: left;\"><span data-preserver-spaces=\"true\">Sphere.it Conf isn’t just another software conference. It’s the place where software engineers and like-minded tech professionals come together to<strong> learn, share, and be part of a powerful developer community</strong> driving innovation in the software industry.</span></p>\r\n&nbsp;\r\n\r\n&nbsp;\r\n<h2 style=\"margin-bottom: 20px; text-align: left;\">Theme</h2>\r\n<p class=\"font-montserrat mb-0\" style=\"font-size: 120%; line-height: 170%; font-weight: 400; text-align: left;\">Explore with us the idea of pushing beyond the traditional definition of seniority in the world of IT. Our conference is tailored for both regular and seasoned IT professionals seeking to expand their knowledge on the latest development opportunities and navigate the challenges that come with an advanced career.</p>\r\n<p class=\"font-montserrat mb-0\" style=\"font-size: 120%; line-height: 170%; font-weight: 400; text-align: left;\">With a focus on management, teamwork, processes, and tools, we <strong>delve deeper into the multidimensional aspects of seniority</strong> and career progression. Come with us on a journey beyond the limits of traditional seniority to unlock the secrets to professional success in IT.</p>",
        "block_button": null,
        "cta_background_color": null,
        "cta_font_color": null,
        "cta_border_radius": null,
        "block_background_image": null,
        "block_background_color": "#f8fcee",
        "block_font_color": "#040c33",
        "menu_label": null
      }
    },

      "data": {
        "block_title": null,
        "block_description": "<div class=\"font-montserrat content\">\r\n\r\nLet's talk about our developers, their happiness, and productivity. What can we do to make their life easier and their work more efficient?\r\n\r\n<span style=\"font-weight: 400;\">Join us for the evening of learning about practices, metrics and tools that make our developers’ lives better.</span>\r\n\r\n</div>",
        "block_button": {
          "title": "Save your seat",
          "url": "https://app.evenea.pl/event/sphere-connect-developer-productivity/",
          "target": "_blank"
        },
        "cta_background_color": "#fae4dc",

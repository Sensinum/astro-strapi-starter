    {
      "kind": "acf",
      "name": "acf/block-half-bg-image",
      "anchor": "acf-block-63ef85357f882",
      "data": {
        "block_description": "<div class=\"font-montserrat content\">\r\n\r\n<strong>Sphere.it Connect</strong> is a carefully crafted series of events tailored to foster meaningful interactions within the tech community.\r\n\r\nEach event is focused on a specific, high-impact theme, creating an intimate setting where <strong>experts</strong>, <strong>enthusiasts</strong>, and <strong>innovators</strong> can come together to exchange knowledge, share experiences, and discuss trends <strong>shaping the future of technology</strong>.\r\n\r\nFrom thought-provoking talks to collaborative sessions and vibrant networking opportunities, Sphere.it Connect is designed to deepen connections, strengthen the community, and inspire innovation.\r\n\r\n</div>",
        "block_button": null,
        "cta_background_color": null,

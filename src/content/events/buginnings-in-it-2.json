    {
      "kind": "acf",
      "name": "acf/block-about-text",
      "anchor": "acf-block-640742082bffe",
      "data": {
        "block_title": null,
        "block_description": "BUGinnnings in IT to seria poświęcona historiom o pierwszych krokach w IT, sknoconych zadaniach, czy nietrafionych pomysłach, opowiedzianym przez doświadczonych ekspertów z branży. Zaproszeni przez nas goście nie wstydzą się spojrzeć wstecz, podzielić się swoimi wpadkami i wyciągniętymi z nich lekcjami. \r\n",
        "block_background_color": "#f7fafc",
        "block_font_color": "#275459",
        "menu_label": null
      }
    },

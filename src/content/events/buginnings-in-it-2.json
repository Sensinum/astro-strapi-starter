      "data": {
        "block_title": null,
        "block_description": "<p class=\"heading-3\" style=\"line-height: 132%; text-align: center;\">Po udanym sierpniowym spotkaniu, 14. października ponownie zapraszamy na pokład krakowskiej Barki, aby posłuchać kolejnych historii o wyzwaniach jakie niosą ze sobą początki w branży IT.</p>",
        "block_background_color": "#f7fafc",
        "block_font_color": "#275459",
        "menu_label": null
      }
    },
    {

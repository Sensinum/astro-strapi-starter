      "kind": "acf",
      "name": "acf/block-full-bg-image",
      "anchor": "acf-block-63ce920e00205",
      "data": {
        "block_title": null,
        "block_description": "<p class=\"font-montserrat\" style=\"font-size: 140%; line-height: 160%; font-weight: 500; text-align: center;\">From the beginnings of programming in the 20th century to the present times entirely driven by technology, the history of IT is full of <strong>#womenheroes</strong>!</p>\r\n<p class=\"font-montserrat\" style=\"font-size: 140%; line-height: 160%; font-weight: 500; text-align: center;\">To celebrate Women's Day, we invite you to get inspired and hear stories from our four invited speakers, successful women from the IT industry.</p>",
        "block_button": null,
        "cta_background_color": null,
        "cta_font_color": null,
        "cta_border_radius": null,
        "block_background_image": null,
        "block_background_color": "#3b2e23",
        "block_font_color": "#f5e8dc",
        "menu_label": null
      }
    },
    {
      "kind": "acf",
      "name": "acf/block-half-bg-image",
      "anchor": "acf-block-63ef85357f882",
      "data": {
        "block_description": "<p class=\"font-montserrat\" style=\"font-size: 140%; line-height: 160%; font-weight: 500; text-align: left;\">The event will be hosted by <a href=\"/contributor/dominika-glazer/\" target=\"_blank\" rel=\"noopener\">Dominika Glazer</a>, Head of Product @ VirtusLab</p>\r\n<p class=\"font-montserrat\" style=\"font-size: 140%; line-height: 160%; font-weight: 500; text-align: left;\">Dominika shared her career story at Inspiring Women in IT 2022. You can watch her presentation <a href=\"/watch/holy-moley-it-did-work/\" target=\"_blank\" rel=\"noopener\">here</a>.</p>",

    {
      "kind": "acf",
      "name": "acf/block-about-text",
      "anchor": "about",
      "data": {
        "block_title": null,
        "block_description": "Zaproszeni przez nas eksperci cofną się o setki tysięcy linijek kodu i kilkanaście projektów wstecz. Zdradzą, w którym momencie powinęła im się noga i jak wybrnęli z sytuacji, które w pierwszym momencie wydawały się nie mieć wyjścia.\r\n\r\nPo wielu miesiącach przerwy mamy okazję spotkać się na żywo i wymienić doświadczeniami, bo jak wiadomo - lepiej uczyć się na cudzych błędach, niż własnych!",
        "block_background_color": "#f7fafc",
        "block_font_color": "#275459",
        "menu_label": null
      }
    },
    {
      "kind": "acf",

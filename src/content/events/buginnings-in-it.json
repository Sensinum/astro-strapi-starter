  "blocks": [
    {
      "kind": "acf",
      "name": "acf/block-about-text",
      "anchor": "about",
      "data": {
        "block_title": null,
        "block_description": "<p class=\"heading-3\" style=\"line-height: 132%; text-align: center;\">Każda historia ma swój początek, a początki bywają trudne. O pierwszych krokach w IT, sknoconych zadaniach, czy nietrafionych pomysłach będziecie mogli posłuchać <strong>już w poniedziałek, 23 sierpnia</strong>.</p>",
        "block_background_color": "#f7fafc",
        "block_font_color": "#275459",
        "menu_label": null
      }
    },
    {
      "kind": "acf",
      "name": "acf/block-speaker-groups-listing",

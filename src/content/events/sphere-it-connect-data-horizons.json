      "data": {
        "block_description": "<b>Sphere.it Connect</b><span style=\"font-weight: 400;\"> is a carefully crafted series of events tailored to foster meaningful interactions within the tech community. Each event is focused on a specific, high-impact theme, creating an intimate setting where experts, enthusiasts, and innovators can come together to exchange knowledge, share experiences in form of talks, lightning talks, discussion panels, workshops and hackathons. <a href=\"/\">Sphere.it</a> events have been organised by the <a href=\"https://virtuslab.com/\">VirtusLab</a> since 2016.</span>",
        "block_button": null,

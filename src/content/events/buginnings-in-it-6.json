      "kind": "acf",
      "name": "acf/block-half-bg-image",
      "anchor": "acf-block-63691d69130af",
      "data": {
        "block_description": "<img style=\"width: 60px;\" src=\"/uploads/2021/12/celeb-min.png\" alt=\"save-the-date\" />\r\n<p class=\"heading-3\" style=\"font-weight: 400;\"><span style=\"font-weight: 400;\">The favourite events for IT beginners are back!\r\nDuring the upcoming session of BUGinnings in IT, we will hear from two top experts: the CTO of SoftwareMill and the Senior Scala Developer from VirtusLab. </span></p>\r\n<p class=\"heading-3\" style=\"font-weight: 400;\"><span style=\"font-weight: 400;\">They'll share lessons from their successful careers and introduce us to the world of open source software.</span></p>",
        "block_button": null,
        "cta_background_color": null,
        "cta_font_color": null,
        "cta_border_radius": null,
        "block_background_image": {
          "id": 3901,
          "url": "/uploads/2022/11/IMG_3524-1-scaled.jpg",

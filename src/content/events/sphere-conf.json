    {
      "kind": "acf",
      "name": "acf/block-half-bg-image",
      "anchor": "acf-block-634941266dcb3",
      "data": {
        "block_description": "<h2 class=\"heading-3\">This year's event will take place at the exceptional Manggha Museum space.</h2>\r\n<span style=\"font-weight: 400;\">The building’s architects designed the museum as a meeting place for two cultures. This makes it the perfect venue for tech pros from across the globe to </span><span style=\"font-weight: 400;\">network and share their expertise. </span>\r\n\r\n<span style=\"font-weight: 400;\">The surroundings and talks provide an ideal icebreaker to reunite with the Sphere.it community.</span>",

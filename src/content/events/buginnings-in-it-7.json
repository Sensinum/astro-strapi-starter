    {
      "kind": "acf",
      "name": "acf/block-half-bg-image",
      "anchor": "acf-block-63692b47b5fcb",
      "data": {
        "block_description": "<img style=\"width: 80px;\" src=\"/uploads/2021/12/bugs-min.png\" alt=\"bugs-logo\" />\r\n<p class=\"font-montserrat\" style=\"font-size: 140%; line-height: 160%; font-weight: 500; text-align: left;\">BUGinnnings in IT is a series of events presenting stories about the first career steps in the tech industry.</p>\r\n<p class=\"font-montserrat\" style=\"font-size: 140%; line-height: 160%; font-weight: 500; text-align: left;\">Specialists with many years of experience come on stage to share their advice, setbacks and lessons learned gained throughout their professional journey. They also explain how to enter their field of specialisation.</p>\r\n<p class=\"font-montserrat\" style=\"font-size: 140%; line-height: 160%; font-weight: 500; text-align: left;\">Come and get inspired!</p>",
        "block_button": null,
        "cta_background_color": null,
        "cta_font_color": null,
        "cta_border_radius": null,
